# Next.js UI — copy to .env.local. Do not commit .env.local.
# In Vercel: Project → Settings → Environment Variables.

# Required: KIRP API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local dev: skip login and use API with SKIP_AUTH=1
NEXT_PUBLIC_SKIP_AUTH=1
NEXT_PUBLIC_UI_PORT=3100
NEXT_PUBLIC_DEV_TOKEN=dev-local-token

# -----------------------------------------------------------------------------
# Backend (FastAPI / Celery / Kafka worker) — NOT read by Next.js.
# Single source of truth: SYSTEM_STATUS.md (RunController & Redis, Governance / OPA, Metrics exposure, alerting, LLM quotas).
# Copy these into the API/worker environment (e.g. docker-compose env, .env for uvicorn).
# Align with dashboard: if NEXT_PUBLIC_SKIP_AUTH=1, set API SKIP_AUTH=1 for local parity.
# SKIP_AUTH=1
# -----------------------------------------------------------------------------
# Pipeline run lifecycle: warn = logs+metrics only; strict = RunStateMissing if no run_id / no state
# PIPELINE_RUN_POLICY=warn
# Orphan run_id in warn mode only: 1 = raise run_missing_state (see SYSTEM_STATUS.md)
# STRICT_RUN_BOUNDARY_FAIL_FAST=0
# RunController Redis: canonical tenant:{tenant_id}:{run_id} + run_lookup:{run_id}
# RUN_CONTROLLER_READ_LEGACY_KEYS=1
# RUN_CONTROLLER_WRITE_LEGACY_RUN_KEY=0
# RUN_CONTROLLER_SCAN_LEGACY_FOR_LIST=0
# Prometheus metrics: 1 = MetricsCollector no-ops (nothing in REGISTRY). See SYSTEM_STATUS → "Metrics exposure".
# DISABLE_PROMETHEUS=0
# OPA: set to empty string in the API/worker env to disable policy HTTP (GovernanceEngine _enabled=false). Call sites use os.getenv("OPA_URL", default)—an empty assigned var overrides default. See SYSTEM_STATUS → "Governance / OPA".
# OPA_URL=http://opa:8181
# LLM cost quota (USD; unset or 0 = unlimited). See SYSTEM_STATUS → "What Changed (LLM quotas / usage API)".
# LLM_QUOTA_LIMIT_USD=0
# LLM routing / pipeline (Direction B). See SYSTEM_STATUS → "What Changed (Direction B — LLM routing + model in run APIs)".
# LLM_LATENCY_BUDGET=
# LLM_COST_BUDGET=
# GEMMA4_OLLAMA_MODEL=
# INGEST_PIPELINE_LLM_ACK=0
# Force LLM provider per task class (optional). See llm_router + SYSTEM_STATUS Direction B.
# BULK_PROVIDER=
# REASONING_PROVIDER=
# Production alerting (Redis hourly counters + active alerts API). See SYSTEM_STATUS → "What Changed (Production alerting)".
# ALERT_FAILURES_PER_HOUR=5
# ALERT_FAILURE_RATE_THRESHOLD=0.2
# ALERT_MIN_SAMPLES_FOR_RATE=10
# ALERT_SLACK_WEBHOOK_URL=
# Optional TTLs (seconds) for hourly counter keys and active-alerts JSON. See SYSTEM_STATUS → "Production alerting".
# ALERT_COUNTER_TTL_SEC=
# ALERT_ACTIVE_TTL_SEC=
# Kafka worker consumer bootstrap (code default: kafka:9092).
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# RAG embedding defaults on worker pipeline build (see kafka_processor).
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# Billing dashboard: Stripe Checkout upgrade (API). See /billing in dashboard.
# STRIPE_PRICE_ID=price_...
# FRONTEND_URL=http://localhost:3100
# Next.js billing + Elements (also STRIPE_SECRET_KEY on API for PaymentIntent).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
