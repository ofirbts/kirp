# Brand OS v3 API — minimal production image
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Brand OS v3 config/agents and SDK + API (no pyproject so PYTHONPATH is enough)
COPY brand_os_v3/ ./brand_os_v3/
COPY brand_os_sdk/ ./brand_os_sdk/
COPY api/ ./api/

RUN pip install --no-cache-dir "fastapi>=0.109.0" "uvicorn[standard]>=0.27.0" "pydantic>=2.0.0"

ENV BRAND_OS_V3_PATH=/app/brand_os_v3
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
