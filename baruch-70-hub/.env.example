# Firebase (Vite exposes only VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore document path uses this app id segment (see App.jsx)
VITE_HUB_APP_ID=baruch-70-hub

# Optional: if set, "editor" actions (approve, lock) require this key in the app (sidebar → מפתח עורך)
VITE_HUB_EDITOR_KEY=
