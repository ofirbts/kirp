# Required (fail-fast on startup)
STRIPE_SECRET_KEY=sk_test_replace_me
DATABASE_URL=postgresql://kirp_user:kirp_password@postgres:5432/kirp
REDIS_URL=redis://redis:6379/0

# Mongo (users, events store) — must use Docker service name, not localhost
MONGO_URI=mongodb://mongo:27017/kirp

# Local dashboard only: set to 1 so the UI works without JWT (never on real production)
# SKIP_AUTH=1

# SaaS runtime
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FRONTEND_URL=https://kirp.ai
ONBOARDING_RL_MAX=5

# Optional sane defaults
ENV=production
API_HOST=0.0.0.0
API_PORT=8000
POSTGRES_DB=kirp
POSTGRES_USER=kirp_user
POSTGRES_PASSWORD=kirp_password
