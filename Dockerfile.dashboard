FROM node:20-alpine AS builder

WORKDIR /app
ARG NEXT_PUBLIC_APP_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$NEXT_PUBLIC_APP_GIT_SHA

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SKIP_AUTH

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SKIP_AUTH=${NEXT_PUBLIC_SKIP_AUTH}
ENV NEXT_PUBLIC_APP_GIT_SHA=${NEXT_PUBLIC_APP_GIT_SHA}

RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app
ARG NEXT_PUBLIC_APP_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$NEXT_PUBLIC_APP_GIT_SHA

ENV NODE_ENV=production
ENV PORT=3100
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_APP_GIT_SHA=${NEXT_PUBLIC_APP_GIT_SHA}

COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.cjs ./

EXPOSE 3100

CMD ["npm", "run", "start"]
