{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/04_Agent_Mesh_Protocol",
  "title": "Agent Mesh Protocol",
  "description": "Orchestration order, handoffs, and data contracts between agents",
  "version": "3.0.0",
  "type": "object",
  "required": ["agents", "flow_order", "handoff_schema", "contracts"],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "phase", "inputs_from", "outputs_to"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "phase": { "type": "string", "enum": ["context", "strategy", "creation", "quality", "distribution"] },
          "inputs_from": { "type": "array", "items": { "type": "string" } },
          "outputs_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "flow_order": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered list of agent IDs for execution"
    },
    "handoff_schema": {
      "type": "object",
      "properties": {
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "optional_fields": { "type": "array", "items": { "type": "string" } },
        "immutable_after": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_agent", "to_agent", "payload_schema_ref"],
        "properties": {
          "from_agent": { "type": "string" },
          "to_agent": { "type": "string" },
          "payload_schema_ref": { "type": "string" },
          "obligations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "rules": [
    "Agents MUST execute in flow_order unless a gatekeeper rejects",
    "Handoff payload MUST include all required_fields from handoff_schema",
    "Fields listed in immutable_after MUST NOT be overwritten by later agents",
    "Contracts define valid payload shape between agent pairs"
  ],
  "thresholds": {
    "max_handoff_size_bytes": 524288,
    "max_agents_per_run": 20,
    "timeout_per_agent_seconds": 120
  },
  "enums": {
    "phase": ["context", "strategy", "creation", "quality", "distribution"]
  },
  "examples": {
    "mesh": {
      "agents": [
        { "id": "CONTEXT_SCANNER", "name": "Context Scanner", "phase": "context", "inputs_from": [], "outputs_to": ["STRATEGIC_PLANNER"] },
        { "id": "STRATEGIC_PLANNER", "name": "Strategic Planner", "phase": "strategy", "inputs_from": ["CONTEXT_SCANNER"], "outputs_to": ["TECHNICAL_STORYTELLER"] },
        { "id": "TECHNICAL_STORYTELLER", "name": "Technical Storyteller", "phase": "creation", "inputs_from": ["STRATEGIC_PLANNER"], "outputs_to": ["HUMAN_EDGE"] },
        { "id": "HUMAN_EDGE", "name": "Human Edge", "phase": "creation", "inputs_from": ["TECHNICAL_STORYTELLER"], "outputs_to": ["IDENTITY_GUARDIAN"] },
        { "id": "IDENTITY_GUARDIAN", "name": "Identity Guardian", "phase": "quality", "inputs_from": ["HUMAN_EDGE"], "outputs_to": ["SKEPTICAL_CTO", "HUMAN_EDGE"] },
        { "id": "SKEPTICAL_CTO", "name": "Skeptical CTO", "phase": "quality", "inputs_from": ["IDENTITY_GUARDIAN"], "outputs_to": ["VISUAL_GENERATOR", "HUMAN_EDGE"] },
        { "id": "VISUAL_GENERATOR", "name": "Visual Generator", "phase": "distribution", "inputs_from": ["SKEPTICAL_CTO"], "outputs_to": [] },
        { "id": "GROWTH_ANALYST", "name": "Growth Analyst", "phase": "distribution", "inputs_from": [], "outputs_to": [] }
      ],
      "flow_order": ["CONTEXT_SCANNER", "STRATEGIC_PLANNER", "TECHNICAL_STORYTELLER", "HUMAN_EDGE", "IDENTITY_GUARDIAN", "SKEPTICAL_CTO", "VISUAL_GENERATOR", "GROWTH_ANALYST"],
      "handoff_schema": {
        "required_fields": ["trace_id", "tenant_id", "platform", "phase_output"],
        "optional_fields": ["revision_notes", "scores", "metadata"],
        "immutable_after": { "CONTEXT_SCANNER": "world_context", "STRATEGIC_PLANNER": "strategy_brief" }
      },
      "contracts": [
        { "from_agent": "CONTEXT_SCANNER", "to_agent": "STRATEGIC_PLANNER", "payload_schema_ref": "context_scanner_output", "obligations": ["world_context", "trends", "signals"] },
        { "from_agent": "STRATEGIC_PLANNER", "to_agent": "TECHNICAL_STORYTELLER", "payload_schema_ref": "strategy_planner_output", "obligations": ["angle", "key_points", "cta"] }
      ]
    }
  }
}
