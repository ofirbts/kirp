{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/00_Master_Identity_Core",
  "title": "Master Identity Core",
  "description": "Canonical brand identity: mission, values, tone, and constraints",
  "version": "3.0.0",
  "type": "object",
  "required": ["brand_name", "mission", "values", "tone_profile", "constraints", "audience_archetypes"],
  "properties": {
    "brand_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Official brand name"
    },
    "mission": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "One-sentence mission statement"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "definition", "priority"],
        "properties": {
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      },
      "minItems": 1,
      "maxItems": 20
    },
    "tone_profile": {
      "type": "object",
      "required": ["primary_tone", "secondary_tones", "avoid"],
      "properties": {
        "primary_tone": {
          "type": "string",
          "enum": ["professional", "friendly", "authoritative", "playful", "empathetic", "bold", "calm", "inspiring"]
        },
        "secondary_tones": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        },
        "avoid": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tones and phrases to never use"
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "forbidden_topics": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } },
        "required_disclaimers": { "type": "array", "items": { "type": "string" } },
        "max_hashtags": { "type": "integer", "minimum": 0, "maximum": 30 },
        "language": { "type": "string", "default": "en" }
      }
    },
    "audience_archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "pain_points": { "type": "array", "items": { "type": "string" } },
          "goals": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "rules": [
    "All generated content MUST align with mission and values",
    "Tone MUST match primary_tone; secondary_tones are optional modifiers",
    "Forbidden topics and claims MUST never appear in output",
    "Required disclaimers MUST be appended when relevant"
  ],
  "thresholds": {
    "identity_alignment_min_score": 0.85,
    "tone_deviation_max": 0.15,
    "value_violation_tolerance": 0
  },
  "enums": {
    "primary_tone": ["professional", "friendly", "authoritative", "playful", "empathetic", "bold", "calm", "inspiring"]
  },
  "examples": {
    "minimal": {
      "brand_name": "TechFlow",
      "mission": "We make complex systems simple so teams can ship with confidence.",
      "values": [
        { "name": "Clarity", "definition": "Say what we mean; no jargon without explanation.", "priority": 1 },
        { "name": "Integrity", "definition": "No overpromising; data over hype.", "priority": 2 }
      ],
      "tone_profile": {
        "primary_tone": "professional",
        "secondary_tones": ["friendly", "calm"],
        "avoid": ["hype", "guaranteed", "revolutionary", "disrupt"]
      },
      "constraints": {
        "forbidden_topics": ["politics", "competitor-bashing"],
        "forbidden_claims": ["#1 in the world", "best in class"],
        "required_disclaimers": ["Past performance does not guarantee future results."],
        "max_hashtags": 5,
        "language": "en"
      },
      "audience_archetypes": [
        { "id": "eng-lead", "name": "Engineering Lead", "description": "Owns delivery and quality.", "pain_points": ["scope creep", "tech debt"], "goals": ["predictable releases", "team morale"] }
      ]
    }
  }
}
