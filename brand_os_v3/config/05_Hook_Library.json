{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/05_Hook_Library",
  "title": "Hook Library",
  "description": "Reusable hooks, openers, and CTAs aligned to brand voice",
  "version": "3.0.0",
  "type": "object",
  "required": ["hooks", "ctas", "openers", "rules"],
  "properties": {
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "category", "platforms"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "category": { "type": "string", "enum": ["question", "statistic", "story", "contrarian", "how_to", "list"] },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "usage_count": { "type": "integer", "minimum": 0 },
          "max_uses_per_month": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "type"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "type": { "type": "string", "enum": ["link", "comment", "share", "dm", "none"] },
          "platforms": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "openers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "tone"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "tone": { "type": "string" },
          "platforms": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "rules": [
    "Hooks MUST be used within category and platform constraints",
    "Usage_count MUST NOT exceed max_uses_per_month per hook",
    "CTAs MUST match platform content_rules (e.g. cta_placement)",
    "Openers SHOULD match current tone_profile"
  ],
  "thresholds": {
    "max_hooks_per_piece": 1,
    "max_ctas_per_piece": 1,
    "opener_reuse_cooldown_days": 7
  },
  "enums": {
    "hook_category": ["question", "statistic", "story", "contrarian", "how_to", "list"],
    "cta_type": ["link", "comment", "share", "dm", "none"]
  },
  "examples": {
    "hooks": [
      { "id": "h1", "text": "What if you could ship every release without last-minute fires?", "category": "question", "platforms": ["linkedin", "twitter"], "usage_count": 2, "max_uses_per_month": 4 },
      { "id": "h2", "text": "Most teams spend 40% of sprint time on rework. Here's how we cut that.", "category": "statistic", "platforms": ["linkedin"], "usage_count": 0, "max_uses_per_month": 2 }
    ],
    "ctas": [
      { "id": "c1", "text": "Try it free →", "type": "link", "platforms": ["linkedin", "twitter"] },
      { "id": "c2", "text": "What would you add? Drop a comment.", "type": "comment", "platforms": ["linkedin"] }
    ],
    "openers": [
      { "id": "o1", "text": "We've been thinking about", "tone": "professional", "platforms": ["linkedin", "whatsapp"] },
      { "id": "o2", "text": "Quick take:", "tone": "bold", "platforms": ["twitter"] }
    ],
    "rules": ["One hook per piece", "One CTA per piece", "Rotate openers to avoid repetition"]
  }
}
