{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/08_Platform_Distribution_Map",
  "title": "Platform Distribution Map",
  "description": "Platform-specific rules, limits, and variants for content distribution",
  "version": "3.0.0",
  "type": "object",
  "required": ["platforms", "variant_schema", "routing_rules"],
  "properties": {
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "limits", "content_rules"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "limits": {
            "type": "object",
            "properties": {
              "max_chars": { "type": "integer" },
              "max_hashtags": { "type": "integer" },
              "max_links": { "type": "integer" },
              "max_images": { "type": "integer" }
            }
          },
          "content_rules": {
            "type": "object",
            "properties": {
              "first_line_hook": { "type": "boolean" },
              "cta_placement": { "type": "string", "enum": ["start", "middle", "end", "none"] },
              "hashtag_placement": { "type": "string", "enum": ["inline", "end", "none"] }
            }
          }
        }
      }
    },
    "variant_schema": {
      "type": "object",
      "properties": {
        "base_content_field": { "type": "string", "default": "body" },
        "variant_fields": { "type": "array", "items": { "type": "string" } },
        "required_adaptations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "routing_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" }
        }
      }
    }
  },
  "rules": [
    "Output per platform MUST respect limits (max_chars, max_hashtags, etc.)",
    "Content_rules MUST be applied when generating platform variants",
    "Only platforms with enabled: true MAY receive distribution"
  ],
  "thresholds": {
    "max_platforms_per_run": 10,
    "variant_deviation_max_chars": 0.1,
    "required_adaptations_compliance": 1.0
  },
  "enums": {
    "cta_placement": ["start", "middle", "end", "none"],
    "hashtag_placement": ["inline", "end", "none"]
  },
  "examples": {
    "platforms": [
      {
        "id": "linkedin",
        "name": "LinkedIn",
        "enabled": true,
        "limits": { "max_chars": 3000, "max_hashtags": 5, "max_links": 1, "max_images": 1 },
        "content_rules": { "first_line_hook": true, "cta_placement": "end", "hashtag_placement": "end" }
      },
      {
        "id": "twitter",
        "name": "Twitter / X",
        "enabled": true,
        "limits": { "max_chars": 280, "max_hashtags": 3, "max_links": 1, "max_images": 4 },
        "content_rules": { "first_line_hook": true, "cta_placement": "end", "hashtag_placement": "end" }
      },
      {
        "id": "whatsapp",
        "name": "WhatsApp",
        "enabled": true,
        "limits": { "max_chars": 1000, "max_hashtags": 0, "max_links": 1, "max_images": 1 },
        "content_rules": { "first_line_hook": false, "cta_placement": "end", "hashtag_placement": "none" }
      }
    ],
    "variant_schema": {
      "base_content_field": "body",
      "variant_fields": ["linkedin_body", "twitter_body", "whatsapp_body"],
      "required_adaptations": ["length", "tone", "cta"]
    },
    "routing_rules": [
      { "condition": "platform in request", "platforms": ["linkedin", "twitter", "whatsapp"], "priority": 1 }
    ]
  }
}
