{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/07_World_Context_Engine",
  "title": "World Context Engine",
  "description": "External and internal signals, trends, and context sources for content decisions",
  "version": "3.0.0",
  "type": "object",
  "required": ["sources", "refresh_policies", "signal_schema", "weighting"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "enabled", "priority"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["news", "social", "market", "internal", "calendar", "rss", "api"] },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
          "config": { "type": "object" },
          "filters": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "refresh_policies": {
      "type": "object",
      "properties": {
        "context_scan_interval_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "cache_ttl_seconds": { "type": "integer", "minimum": 60 },
        "max_signals_per_run": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "signal_schema": {
      "type": "object",
      "required": ["id", "source_id", "type", "title", "relevance_score", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "source_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "weighting": {
      "type": "object",
      "properties": {
        "recency_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_priority_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_combined_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "rules": [
    "Signals MUST conform to signal_schema before being passed to CONTEXT_SCANNER",
    "Refresh policies MUST be respected; stale context SHOULD be flagged",
    "Weighting MUST be used to rank and filter signals for strategy phase"
  ],
  "thresholds": {
    "min_signals_for_strategy": 1,
    "max_context_age_hours": 168,
    "relevance_floor": 0.3
  },
  "enums": {
    "source_type": ["news", "social", "market", "internal", "calendar", "rss", "api"]
  },
  "examples": {
    "config": {
      "sources": [
        { "id": "tech-news", "type": "news", "enabled": true, "priority": 8, "config": { "feed_url": "https://example.com/tech" }, "filters": ["product", "engineering"] },
        { "id": "internal-metrics", "type": "internal", "enabled": true, "priority": 9, "config": {}, "filters": [] }
      ],
      "refresh_policies": {
        "context_scan_interval_minutes": 60,
        "cache_ttl_seconds": 3600,
        "max_signals_per_run": 50
      },
      "signal_schema": {
        "id": "string",
        "source_id": "string",
        "type": "string",
        "title": "string",
        "body": "string",
        "relevance_score": "number 0-1",
        "timestamp": "ISO8601",
        "tags": "string[]",
        "url": "uri"
      },
      "weighting": {
        "recency_weight": 0.4,
        "relevance_weight": 0.4,
        "source_priority_weight": 0.2,
        "min_combined_score": 0.35
      }
    },
    "sample_signal": {
      "id": "sig-001",
      "source_id": "tech-news",
      "type": "article",
      "title": "New API release simplifies auth",
      "body": "Summary of the release.",
      "relevance_score": 0.85,
      "timestamp": "2025-01-29T12:00:00Z",
      "tags": ["api", "auth", "release"],
      "url": "https://example.com/article"
    }
  }
}
