{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://brand-os.example/schemas/03_Voice_Engine",
  "title": "Voice Engine",
  "description": "Linguistic and stylistic rules for brand voice across channels",
  "version": "3.0.0",
  "type": "object",
  "required": ["voice_id", "sentence_rules", "vocabulary", "platform_adaptations"],
  "properties": {
    "voice_id": {
      "type": "string",
      "description": "Unique identifier linking to Master Identity Core"
    },
    "sentence_rules": {
      "type": "object",
      "properties": {
        "max_sentence_length": { "type": "integer", "minimum": 5, "maximum": 200, "default": 25 },
        "prefer_active_voice": { "type": "boolean", "default": true },
        "max_syllables_per_word_avg": { "type": "number", "minimum": 1, "maximum": 5, "default": 2.2 },
        "avoid_sentence_starters": { "type": "array", "items": { "type": "string" } },
        "preferred_openers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "vocabulary": {
      "type": "object",
      "properties": {
        "preferred_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "context"],
            "properties": {
              "term": { "type": "string" },
              "context": { "type": "string" },
              "replace_instead_of": { "type": "string" }
            }
          }
        },
        "banned_terms": { "type": "array", "items": { "type": "string" } },
        "banned_phrases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "platform_adaptations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "max_chars": { "type": "integer" },
          "hashtag_style": { "type": "string", "enum": ["none", "minimal", "end", "inline"] },
          "emoji_policy": { "type": "string", "enum": ["none", "sparse", "moderate", "allowed"] },
          "cta_required": { "type": "boolean" }
        }
      }
    }
  },
  "rules": [
    "Output MUST respect sentence_rules for readability",
    "Vocabulary preferred_terms SHOULD be used where context matches",
    "Banned terms and phrases MUST never appear",
    "Platform_adaptations override defaults when platform is specified"
  ],
  "thresholds": {
    "readability_target_grade_level_max": 10,
    "passive_voice_ratio_max": 0.2,
    "banned_term_occurrence": 0
  },
  "enums": {
    "hashtag_style": ["none", "minimal", "end", "inline"],
    "emoji_policy": ["none", "sparse", "moderate", "allowed"]
  },
  "examples": {
    "default_voice": {
      "voice_id": "techflow-v1",
      "sentence_rules": {
        "max_sentence_length": 22,
        "prefer_active_voice": true,
        "max_syllables_per_word_avg": 2.0,
        "avoid_sentence_starters": ["Actually", "Basically", "So"],
        "preferred_openers": ["We", "Our", "Here's", "Try"]
      },
      "vocabulary": {
        "preferred_terms": [
          { "term": "release", "context": "product", "replace_instead_of": "launch" },
          { "term": "team", "context": "general", "replace_instead_of": "folks" }
        ],
        "banned_terms": ["synergy", "leverage", "disrupt", "game-changer"],
        "banned_phrases": ["at the end of the day", "move the needle", "low-hanging fruit"]
      },
      "platform_adaptations": {
        "linkedin": { "max_chars": 3000, "hashtag_style": "end", "emoji_policy": "sparse", "cta_required": true },
        "twitter": { "max_chars": 280, "hashtag_style": "minimal", "emoji_policy": "moderate", "cta_required": false },
        "whatsapp": { "max_chars": 1000, "hashtag_style": "none", "emoji_policy": "allowed", "cta_required": false }
      }
    }
  }
}
