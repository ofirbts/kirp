{
  "id": "master_orchestrator_workflow",
  "name": "Brand OS v3 Master Orchestrator",
  "version": "3.0.0",
  "description": "Orchestration flow: trigger, agents, gatekeeper loops, platform variants, logging, visual generation, final output.",
  "trigger": {
    "type": "manual",
    "input_schema": {
      "type": "object",
      "required": ["tenant_id", "platform", "topic_hint"],
      "properties": {
        "tenant_id": { "type": "string" },
        "platform": { "type": "string", "enum": ["linkedin", "twitter", "whatsapp"] },
        "topic_hint": { "type": "string" },
        "signals": { "type": "array" },
        "memory_entries": { "type": "array" }
      }
    }
  },
  "nodes": [
    { "id": "prepare_input", "type": "function", "name": "Prepare Input", "config": {} },
    { "id": "context_scanner", "type": "function", "name": "CONTEXT_SCANNER", "config": {} },
    { "id": "strategic_planner", "type": "function", "name": "STRATEGIC_PLANNER", "config": {} },
    { "id": "technical_storyteller", "type": "function", "name": "TECHNICAL_STORYTELLER", "config": {} },
    { "id": "human_edge", "type": "function", "name": "HUMAN_EDGE", "config": {} },
    { "id": "identity_guardian", "type": "function", "name": "IDENTITY_GUARDIAN", "config": {} },
    { "id": "if_identity_approved", "type": "if", "name": "Identity Approved?", "config": { "condition": "{{ $json.approved }}" } },
    { "id": "skeptical_cto", "type": "function", "name": "SKEPTICAL_CTO", "config": {} },
    { "id": "if_cto_approved", "type": "if", "name": "CTO Approved?", "config": { "condition": "{{ $json.approved }}" } },
    { "id": "revision_identity", "type": "function", "name": "Revision (Identity)", "config": {} },
    { "id": "revision_cto", "type": "function", "name": "Revision (CTO)", "config": {} },
    { "id": "visual_generator", "type": "function", "name": "VISUAL_GENERATOR", "config": {} },
    { "id": "logging", "type": "function", "name": "Logging", "config": {} },
    { "id": "final_output", "type": "set", "name": "Final Output", "config": {} },
    { "id": "growth_analyst", "type": "function", "name": "GROWTH_ANALYST", "config": {} }
  ],
  "connections": [
    { "from": "prepare_input", "to": "context_scanner" },
    { "from": "context_scanner", "to": "strategic_planner" },
    { "from": "strategic_planner", "to": "technical_storyteller" },
    { "from": "technical_storyteller", "to": "human_edge" },
    { "from": "human_edge", "to": "identity_guardian" },
    { "from": "identity_guardian", "to": "if_identity_approved" },
    { "from": "if_identity_approved", "to_true": "skeptical_cto", "to_false": "revision_identity" },
    { "from": "revision_identity", "to": "human_edge" },
    { "from": "skeptical_cto", "to": "if_cto_approved" },
    { "from": "if_cto_approved", "to_true": "visual_generator", "to_false": "revision_cto" },
    { "from": "revision_cto", "to": "human_edge" },
    { "from": "visual_generator", "to": "logging" },
    { "from": "logging", "to": "growth_analyst" },
    { "from": "growth_analyst", "to": "final_output" }
  ],
  "flow_order": [
    "prepare_input",
    "context_scanner",
    "strategic_planner",
    "technical_storyteller",
    "human_edge",
    "identity_guardian",
    "if_identity_approved",
    "skeptical_cto",
    "if_cto_approved",
    "visual_generator",
    "logging",
    "growth_analyst",
    "final_output"
  ],
  "gatekeeper_loops": [
    {
      "gatekeeper": "IDENTITY_GUARDIAN",
      "on_reject": "revision_identity",
      "revision_target": "human_edge",
      "max_iterations": 1,
      "payload_revision_notes": "revision_notes"
    },
    {
      "gatekeeper": "SKEPTICAL_CTO",
      "on_reject": "revision_cto",
      "revision_target": "human_edge",
      "max_iterations": 1,
      "payload_revision_notes": "revision_notes"
    }
  ],
  "platform_variants": {
    "linkedin": { "max_chars": 3000, "hashtag_style": "end", "cta_placement": "end" },
    "twitter": { "max_chars": 280, "hashtag_style": "end", "cta_placement": "end" },
    "whatsapp": { "max_chars": 1000, "hashtag_style": "none", "cta_placement": "end" }
  },
  "logging_logic": {
    "log_at_nodes": ["prepare_input", "identity_guardian", "skeptical_cto", "final_output"],
    "fields": ["trace_id", "tenant_id", "platform", "topic_hint", "approved", "revision_count_identity", "revision_count_cto"],
    "storage": "event_store",
    "event_type": "brand_os_v3.workflow.step"
  },
  "visual_generation_logic": {
    "trigger_after": "if_cto_approved (true)",
    "input": "polished_draft + visual_identity",
    "output": "visual_spec (image_prompt, aspect_ratio, format, alt_text)",
    "downstream_use": "Optional HTTP to image API or store spec for later"
  },
  "final_output_schema": {
    "type": "object",
    "required": ["trace_id", "tenant_id", "platform", "topic_hint", "content", "visual_spec", "recommendations", "status"],
    "properties": {
      "trace_id": { "type": "string" },
      "tenant_id": { "type": "string" },
      "platform": { "type": "string" },
      "topic_hint": { "type": "string" },
      "content": {
        "type": "object",
        "properties": {
          "headline": { "type": "string" },
          "body": { "type": "string" },
          "hook_used": { "type": "string" },
          "cta_used": { "type": "string" }
        }
      },
      "visual_spec": {
        "type": "object",
        "properties": {
          "image_prompt": { "type": "string" },
          "aspect_ratio": { "type": "string" },
          "format": { "type": "string" },
          "alt_text": { "type": "string" }
        }
      },
      "recommendations": {
        "type": "object",
        "properties": {
          "suggested_timing": { "type": "string" },
          "hook_rotation": { "type": "array" },
          "cta_rotation": { "type": "array" },
          "next_topic_hints": { "type": "array" }
        }
      },
      "status": { "type": "string", "enum": ["approved", "rejected_identity", "rejected_cto"] }
    }
  },
  "example_workflow_run": {
    "input": {
      "tenant_id": "tenant-1",
      "platform": "linkedin",
      "topic_hint": "API release",
      "signals": [{ "id": "sig-1", "title": "New API simplifies auth", "relevance_score": 0.9 }],
      "memory_entries": []
    },
    "steps": [
      { "step": "prepare_input", "output": { "trace_id": "trace-001", "tenant_id": "tenant-1", "platform": "linkedin", "topic_hint": "API release" } },
      { "step": "context_scanner", "output": { "world_context": "API and auth in focus...", "trends": ["API-first auth", "DevEx"], "memory_summary": "No recent content." } },
      { "step": "strategic_planner", "output": { "strategy_brief": { "angle": "Our new API turns auth into one line of config.", "key_points": ["What changed", "How it reduces rework", "Where to try it"] } } },
      { "step": "technical_storyteller", "output": { "draft": { "headline": "Auth as one line of config", "body": "What if you could ship...\n\nWe just shipped..." } } },
      { "step": "human_edge", "output": { "polished_draft": { "headline": "Auth as one line of config", "body": "What if you could ship...\n\nWe just shipped... Same security, less code.\n\nTry it free →" } } },
      { "step": "identity_guardian", "output": { "approved": true, "identity_alignment": 0.92, "tone_deviation": 0.08 } },
      { "step": "skeptical_cto", "output": { "approved": true, "technical_accuracy": 0.9, "overclaim_risk": 0.1 } },
      { "step": "visual_generator", "output": { "visual_spec": { "image_prompt": "Minimal diagram: one line of code, lock icon...", "aspect_ratio": "1.91:1", "format": "png", "alt_text": "Diagram: auth as one line of config." } } },
      { "step": "logging", "output": { "logged": true } },
      { "step": "growth_analyst", "output": { "recommendations": { "suggested_timing": "Tuesday 9am local", "next_topic_hints": ["DevEx metrics", "Security vs speed"] } } }
    ],
    "final_output": {
      "trace_id": "trace-001",
      "tenant_id": "tenant-1",
      "platform": "linkedin",
      "topic_hint": "API release",
      "content": {
        "headline": "Auth as one line of config",
        "body": "What if you could ship every release without last-minute fires?\n\nWe just shipped an API change that turns auth from a bottleneck into one line of config. Same security, less code.\n\nTry it free →",
        "hook_used": "What if you could ship every release without last-minute fires?",
        "cta_used": "Try it free →"
      },
      "visual_spec": {
        "image_prompt": "Minimal diagram: one line of code, lock icon, brand colors.",
        "aspect_ratio": "1.91:1",
        "format": "png",
        "alt_text": "Diagram: auth as one line of config."
      },
      "recommendations": {
        "suggested_timing": "Tuesday 9am local",
        "hook_rotation": ["h1", "h2"],
        "cta_rotation": ["c1"],
        "next_topic_hints": ["DevEx metrics", "Security vs speed"]
      },
      "status": "approved"
    }
  }
}
